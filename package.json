{
  "name": "atwar-bss---enterprise-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "prisma generate",
    "server:dev": "node --watch server/index.mjs",
    "server:start": "node server/index.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init_sync",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run typecheck:strict && npm run audit:quality",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "audit:routes": "node scripts/qa/audit-routes-actions.mjs",
    "audit:placeholders": "node scripts/qa/audit-placeholders.mjs",
    "audit:postgres": "node scripts/qa/audit-postgres-integrity.mjs",
    "audit:awaited-writes": "node scripts/qa/audit-awaited-db-writes.mjs",
    "audit:quality": "npm run audit:routes && npm run audit:placeholders && npm run audit:postgres && npm run audit:awaited-writes",
    "qa:checklist": "node scripts/qa/generate-screen-checklist.mjs",
    "qa:close-routes": "node scripts/qa/close-route-certification-gaps.mjs",
    "qa:dashboard": "node scripts/qa/generate-module-progress-dashboard.mjs",
    "qa:gaps": "node scripts/qa/generate-gap-execution-queue.mjs",
    "qa:status": "npm run qa:dashboard && npm run qa:gaps",
    "ops:reconcile": "node scripts/ops/reconcile-postgres.mjs",
    "ops:health": "node scripts/ops/check-api-health.mjs",
    "ops:health:alerts": "node scripts/ops/check-infra-health-alerts.mjs",
    "ops:smoke:concurrency": "node scripts/ops/smoke-multi-user-concurrency.mjs",
    "ops:go-live:checklist": "node scripts/ops/go-live-checklist.mjs",
    "ops:go-live": "npm run ops:go-live:checklist",
    "ops:move:products-location": "node scripts/ops/move-products-to-location.mjs",
    "ops:merge:duplicate-products": "node scripts/ops/merge-location-duplicate-products.mjs",
    "ops:stock:reset-seed-location": "node scripts/ops/reset-seed-location-stock-from-xlsx.mjs",
    "ops:import:price-lists": "node scripts/ops/import-selling-price-lists.mjs",
    "test:unit": "vitest run",
    "test:context": "vitest run tests/context/global-context.integration.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/ui-fit.spec.ts",
    "test:large-data": "playwright test e2e/large-data.spec.ts",
    "qa:all": "npm run typecheck:strict && npm run audit:quality && npm run test:context && npm run test:e2e:smoke",
    "release:check": "node scripts/qa/release-gate.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.9",
    "prisma": "^6.7.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
